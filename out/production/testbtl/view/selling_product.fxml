<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #f4f4f4;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.controller.SellingProductController">
    <children>
        <HBox prefHeight="600.0" prefWidth="900.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <VBox prefWidth="200.0" style="-fx-background-color: #f4f4f4; -fx-border-color: #ddd; -fx-border-width: 0 1 0 0;">
                    <children>
                        <Label fx:id="lblUsername" alignment="CENTER" prefHeight="60.0" prefWidth="200.0" text="username">
                            <font><Font name="System Bold" size="17.0" /></font>
                        </Label>
                        <Button mnemonicParsing="false" onAction="#goToHome" prefHeight="50.0" prefWidth="200.0" style="-fx-background-color: #888; -fx-text-fill: white; -fx-font-weight: bold;" text="MUA HÀNG" />
                        <Button mnemonicParsing="false" onAction="#goToSellerScreen" prefHeight="50.0" prefWidth="200.0" style="-fx-background-color: transparent; -fx-font-weight: bold;" text="BÁN HÀNG" />
                        <VBox VBox.vgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#logout" prefHeight="50.0" prefWidth="200.0" style="-fx-background-color: #ff4444; -fx-text-fill: white; -fx-font-weight: bold; -fx-border-color: #ddd; -fx-border-width: 1 0 0 0;" text="ĐĂNG XUẤT">
                            <VBox.margin><Insets bottom="10.0" /></VBox.margin>
                        </Button>
                    </children>
                </VBox>

                <VBox alignment="TOP_LEFT" spacing="15" style="-fx-padding: 20 30 20 30;" HBox.hgrow="ALWAYS">
                    <HBox>
                        <!-- TITLE -->
                        <Label prefHeight="89.0" prefWidth="251.0" text="CHI TIẾT SẢN PHẨM">
                            <font>
                                <Font name="System Bold" size="26" />
                            </font>
                        </Label>

                        <Region prefHeight="37.0" prefWidth="428.0" HBox.hgrow="ALWAYS" />

                        <Button alignment="CENTER" lineSpacing="10.0" mnemonicParsing="false" onAction="#goToHome" prefHeight="49.0" prefWidth="134.0" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" text="QUAY LẠI">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Button>
                    </HBox>
                    <!-- MAIN CONTENT -->
                    <HBox alignment="TOP_LEFT" spacing="60" HBox.hgrow="ALWAYS">

                        <!-- IMAGE -->
                        <VBox alignment="TOP_CENTER" prefHeight="536.0" prefWidth="379.0" spacing="15">
                            <children>

                                <StackPane prefHeight="380" prefWidth="450" style="-fx-border-color: black;                               -fx-border-width: 3;                               -fx-border-radius: 30;                               -fx-background-radius: 30;                               -fx-background-color: #d9d9d9;">

                                    <children>
                                        <ImageView fx:id="imgProduct" fitHeight="395.0" fitWidth="600.0" preserveRatio="true" />
                                    </children>
                                </StackPane>

                                <Label fx:id="lblProductInfo" text="Mô tả" wrapText="true">
                                    <font>
                                        <Font name="System Bold" size="20.0" />
                                    </font>
                                </Label>

                            </children>
                        </VBox>

                        <!-- INFO -->
                        <VBox alignment="TOP_LEFT" prefHeight="499.0" prefWidth="291.0" spacing="15" HBox.hgrow="ALWAYS">

                            <Label fx:id="lblProductName" prefHeight="50.0" prefWidth="476.0" text="Tên sản phẩm">
                                <font><Font name="System Bold" size="30.0" /></font>
                            </Label>

                            <Label fx:id="lblCurrentPrice" prefHeight="45.0" text="Giá hiện tại: ">
                                <font><Font name="System Bold" size="26.0" /></font>
                            </Label>

                            <!-- ĐẶT GIÁ -->
                            <Label text="Đặt giá:" style="-fx-font-weight: bold; -fx-font-size: 18px;" />
                            <TextField fx:id="txtBidAmount" prefHeight="46.0" prefWidth="250.0" promptText="Nhập giá..."
                                       style="-fx-border-color: black; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 0 10; -fx-font-size: 18px;" />
                            <Text fx:id="priceCheck" strokeType="OUTSIDE" strokeWidth="0.0" style="-fx-fill: red;">
                                <font><Font size="15.0" /></font>
                            </Text>
                            <HBox spacing="10">
                                <Button fx:id="btnConfirm" onAction="#handleConfirmBid" prefHeight="46" prefWidth="160"
                                        style="-fx-background-color: #bfbfbf; -fx-text-fill: #666; -fx-font-weight: bold; -fx-background-radius: 10;" text="Xác nhận" />
                                <Button onAction="#handleAutoBid" prefHeight="46" prefWidth="160"
                                        style="-fx-background-color: #FF9800; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10;" text="🤖 Auto-Bid" />
                            </HBox>

                            <!-- LỊCH SỬ ĐẶT GIÁ -->
                            <Label text="Lịch sử đặt giá:" style="-fx-font-weight: bold; -fx-font-size: 16px;" />
                            <ScrollPane fitToWidth="true" prefHeight="180.0" style="-fx-background-color: transparent;">
                                <content>
                                    <VBox fx:id="vboxBidHistory" spacing="5" style="-fx-padding: 5;">
                                        <Label text="Chưa có lịch sử." style="-fx-text-fill: #888;" />
                                    </VBox>
                                </content>
                            </ScrollPane>

                        </VBox>

                    </HBox>

                </VBox>
            </children>
        </HBox>
    </children>
</AnchorPane>
