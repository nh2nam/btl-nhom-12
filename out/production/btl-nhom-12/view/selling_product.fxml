<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.text.Text?>
<VBox prefHeight="800.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.controller.SellingProductController">
    <children>
        <HBox alignment="CENTER_LEFT" prefHeight="110.0" style="-fx-background-color: black; -fx-border-color: #333333; -fx-border-width: 0 0 1 0; -fx-padding: 20 30 20 30">
            <padding>
                <Insets left="40.0" right="40.0" />
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label fx:id="lblUsername" onMouseEntered="#handleShowUserMenu" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;">
                            <font>
                                <Font size="20.0" />
                            </font>
                            <contextMenu>
                                <ContextMenu fx:id="userMenu" style="-fx-background-color: #1a1a1a; -fx-font-weight: bold; -fx-color: white; -fx-font-size: 20;">
                                    <items>
                                        <MenuItem text="Thông tin cá nhân" />
                                        <MenuItem text="Sản phẩm của bạn" />
                                        <MenuItem text="Lịch sử đấu giá thành công" />
                                    </items>
                                </ContextMenu>
                            </contextMenu>
                        </Label>
                    </children>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="50.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label onMouseEntered="#handleShowAuctionMenu" style="-fx-text-fill: white; -fx-font-size: 20; -fx-font-weight: bold; -fx-cursor: hand;" text="Tài sản đấu giá">
                            <contextMenu>
                                <ContextMenu fx:id="auctionMenu" style="-fx-background-color: #1a1a1a; -fx-font-weight: bold; -fx-color: white; -fx-font-size: 20;">
                                    <items>
                                        <MenuItem text="Nghệ thuật" />
                                        <MenuItem text="Điện tủ" />
                                        <MenuItem text="Phương tiện - xe cộ" />
                                        <MenuItem text="Tài sản khác" />
                                    </items>
                                </ContextMenu>
                            </contextMenu>
                        </Label>

                        <Label onMouseEntered="#handleShowSessionMenu" style="-fx-text-fill: white; -fx-font-size: 20; -fx-font-weight: bold; -fx-cursor: hand;" text="Phiên đấu giá">
                            <contextMenu>
                                <ContextMenu fx:id="sessionMenu" style="-fx-background-color: #1a1a1a; -fx-font-weight: bold; -fx-color: white; -fx-font-size: 20;">
                                    <items>
                                        <MenuItem text="Phiên đấu giá đang diễn ra" />
                                        <MenuItem text="Phiên đấu giá đã kết thúc" />
                                    </items>
                                </ContextMenu>
                            </contextMenu>
                        </Label>
                        <Label onMouseClicked="#addNewProduct" style="-fx-text-fill: white; -fx-font-size: 20; -fx-font-weight: bold; -fx-cursor: hand;" text="Tạo phiên đấu giá mới"/>


                    </children>
                    <padding>
                        <Insets left="100.0" />
                    </padding>
                </HBox>

                <HBox alignment="CENTER_RIGHT">
                    <children>
                        <Button mnemonicParsing="false" onMouseClicked="#logout" prefHeight="50.0" prefWidth="150.0" style="-fx-background-color: #CC0000; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 18; -fx-background-radius: 5; -fx-cursor: hand; -fx-padding: 17 0 17 0" text="Đăng xuất" />
                    </children>
                </HBox>
            </children>
        </HBox>

        <ScrollPane fitToWidth="true" style="-fx-background-color: #1a1a1a; -fx-background: #1a1a1a;" VBox.vgrow="ALWAYS">
            <content>
                <HBox spacing="40.0" style="-fx-padding: 0 40 40 40;">

                    <VBox spacing="20.0" HBox.hgrow="ALWAYS">

                        <VBox alignment="CENTER" style="-fx-background-color: #2a2a2a; -fx-background-radius: 10; -fx-padding: 20;">
                            <ImageView fx:id="imgProduct" fitWidth="700.0" preserveRatio="true" />
                        </VBox>

                        <VBox spacing="10.0" style="-fx-background-color: #2a2a2a; -fx-background-radius: 10; -fx-padding: 25;">
                            <Label text="Chi tiết tài sản đấu giá" style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;" />
                            <Separator style="-fx-background-color: #444;" />
                            <Label fx:id="lblProductInfo" wrapText="true" style="-fx-text-fill: #cccccc; -fx-font-size: 16px; -fx-line-spacing: 5px;" />
                            <Label fx:id="description" wrapText="true" style="-fx-text-fill: #cccccc; -fx-font-size: 16px; -fx-line-spacing: 5px;" />
                        </VBox>

                    </VBox>


                    <VBox spacing="20.0" prefWidth="450.0" minWidth="450.0" style="-fx-background-color: #2a2a2a; -fx-background-radius: 10; -fx-border-color: #444; -fx-border-radius: 10; -fx-border-width: 1; -fx-padding: 30;">

                        <Label fx:id="lblProductName" wrapText="true" style="-fx-text-fill: white; -fx-font-size: 26px; -fx-font-weight: bold;" />

                        <Separator style="-fx-background-color: #444;" />

                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <Label text="Giá khởi điểm:" prefWidth="150" style="-fx-text-fill: #aaaaaa; -fx-font-size: 16px;" />
                            <Label fx:id="lblStartingPrice" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;" />
                        </HBox>

                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <Label text="Giá hiện tại:" prefWidth="150" style="-fx-text-fill: #aaaaaa; -fx-font-size: 16px;" />
                            <Label fx:id="lblCurrentPrice" style="-fx-text-fill: #ff5252; -fx-font-size: 24px; -fx-font-weight: bold;" />
                        </HBox>

                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <Label text="Thời gian kết thúc:" prefWidth="150" style="-fx-text-fill: #aaaaaa; -fx-font-size: 16px;" />
                            <Label fx:id="lblEndTime" style="-fx-text-fill: #4CAF50; -fx-font-size: 16px; -fx-font-weight: bold;" />
                        </HBox>

                        <Separator style="-fx-background-color: #444;" />

                        <VBox spacing="10.0" style="-fx-padding: 10 0 0 0;">
                            <Label text="Nhập mức giá bạn muốn trả:" style="-fx-text-fill: white; -fx-font-size: 14px;" />
                            <TextField fx:id="txtBidAmount" promptText="Nhap gia" HBox.hgrow="ALWAYS" style="-fx-font-size: 16px; -fx-background-color: #1a1a1a; -fx-text-fill: white; -fx-border-color: #555; -fx-border-radius: 5;" prefHeight="45.0"/>
                        </VBox>

                        <VBox spacing="15.0" style="-fx-padding: 15 0 0 0;">
                            <Text fx:id="priceCheck" style="-fx-font-size: 15px; -fx-font-weight: bold;-fx-alignment: center; "/>
                            <Button fx:id="btnConfirm" text="ĐẶT GIÁ" onAction="#handleConfirmBid" maxWidth="Infinity" prefHeight="55.0" style="-fx-background-color: #d32f2f; -fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" />

                            <Button text="ĐẤU GIÁ TỰ ĐỘNG" onAction="#handleAutoBid" maxWidth="Infinity" prefHeight="55.0" style="-fx-background-color: #1976D2; -fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" />
                        </VBox>
                        <VBox.vgrow />
                        <VBox spacing="15.0" style="-fx-padding: 15 0 0 0;">

                            <Button text="QUAY LẠI" onAction="#goHome" maxWidth="Infinity" prefHeight="55.0" style="-fx-background-color: red; -fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" />
                        </VBox>


                    </VBox>
                </HBox>
            </content>
        </ScrollPane>
    </children>
</VBox>