<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="800.0" prefWidth="1280.0"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.auction.client.controller.HomeController">
    <children>

        <!-- ===== NAVBAR (cùng cấu trúc với selling_product.fxml) ===== -->
        <HBox alignment="CENTER_LEFT" prefHeight="110.0"
              style="-fx-background-color: black; -fx-border-color: #333333; -fx-border-width: 0 0 1 0; -fx-padding: 20 30 20 30">
            <padding><Insets left="40.0" right="40.0" /></padding>
            <children>

                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label fx:id="lblUsername"
                               onMouseEntered="#handleShowUserMenu"
                               style="-fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;">
                            <font><Font size="20.0" /></font>
                            <contextMenu>
                                <ContextMenu fx:id="userMenu"
                                             style="-fx-background-color: #1a1a1a; -fx-font-weight: bold; -fx-color: white; -fx-font-size: 20;">
                                    <items>
                                        <MenuItem text="Thông tin cá nhân" />
                                        <MenuItem text="Sản phẩm của bạn" />
                                        <MenuItem text="Lịch sử đấu giá thành công" onAction="#goToMyResults"/>
                                        <MenuItem text="Đăng xuất" onAction="#logout"/>
                                    </items>
                                </ContextMenu>
                            </contextMenu>
                        </Label>
                    </children>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="50.0" HBox.hgrow="ALWAYS">
                    <padding><Insets left="100.0" /></padding>
                    <children>
                        <Label onMouseEntered="#handleShowAuctionMenu"
                               style="-fx-text-fill: white; -fx-font-size: 20; -fx-font-weight: bold; -fx-cursor: hand;"
                               text="Tài sản đấu giá">
                            <contextMenu>
                                <ContextMenu fx:id="auctionMenu"
                                             style="-fx-background-color: #1a1a1a; -fx-font-weight: bold; -fx-color: white; -fx-font-size: 20;">
                                    <items>
                                        <MenuItem text="Nghệ thuật" onAction="#filterByCategory"/>
                                        <MenuItem text="Điện tử" onAction="#filterByCategory"/>
                                        <MenuItem text="Bất động sản" onAction="#filterByCategory"/>
                                        <MenuItem text="Thời trang" onAction="#filterByCategory"/>
                                        <MenuItem text="Tài sản khác" onAction="#filterByCategory"/>
                                    </items>
                                </ContextMenu>
                            </contextMenu>
                        </Label>

                        <Label onMouseEntered="#handleShowSessionMenu"
                               style="-fx-text-fill: white; -fx-font-size: 20; -fx-font-weight: bold; -fx-cursor: hand;"
                               text="Phiên đấu giá">
                            <contextMenu>
                                <ContextMenu fx:id="sessionMenu"
                                             style="-fx-background-color: #1a1a1a; -fx-font-weight: bold; -fx-color: white; -fx-font-size: 20;">
                                    <items>
                                        <MenuItem text="Tất cả phiên đấu giá" onAction="#filterByStatus"/>
                                        <MenuItem text="Phiên đấu giá đang diễn ra" onAction="#filterByStatus"/>
                                        <MenuItem text="Phiên đấu giá đã kết thúc" onAction="#filterByStatus"/>
                                    </items>
                                </ContextMenu>
                            </contextMenu>
                        </Label>

                        <Label onMouseClicked="#addNewProduct"
                               style="-fx-text-fill: white; -fx-font-size: 20; -fx-font-weight: bold; -fx-cursor: hand;"
                               text="Tạo phiên đấu giá mới"/>
                    </children>
                </HBox>


            </children>
        </HBox>

        <ScrollPane fitToHeight="true" fitToWidth="true" style="-fx-background-color: #111111;" VBox.vgrow="ALWAYS">
            <content>
                <VBox fx:id="vboxProducts" spacing="20.0" style="-fx-background-color: black; -fx-padding: 30 150 50 150;" />
            </content>
        </ScrollPane>

    </children>
</VBox>
