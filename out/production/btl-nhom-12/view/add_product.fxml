<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="800.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.controller.AddProductController">
    <children>
        <HBox alignment="CENTER_LEFT" prefHeight="110.0" style="-fx-background-color: black; -fx-border-color: #333333; -fx-border-width: 0 0 1 0; -fx-padding: 20 30 20 30">
            <padding>
                <Insets left="40.0" right="40.0" />
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label fx:id="lblUsername" onMouseEntered="#handleShowUserMenu" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;">
                            <font>
                                <Font size="20.0" />
                            </font>
                            <contextMenu>
                                <ContextMenu fx:id="userMenu" style="-fx-background-color: #1a1a1a; -fx-font-weight: bold; -fx-color: white; -fx-font-size: 20;">
                                    <items>
                                        <MenuItem text="Thông tin cá nhân" />
                                        <MenuItem text="Sản phẩm của bạn" />
                                        <MenuItem text="Lịch sử đấu giá thành công"/>
                                        <MenuItem text="Đăng xuất" onAction="#logout"/>
                                    </items>
                                </ContextMenu>
                            </contextMenu>
                        </Label>
                    </children>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="50.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label onMouseEntered="#handleShowAuctionMenu" style="-fx-text-fill: white; -fx-font-size: 20; -fx-font-weight: bold; -fx-cursor: hand;" text="Tài sản đấu giá">
                            <contextMenu>
                                <ContextMenu fx:id="auctionMenu" style="-fx-background-color: #1a1a1a; -fx-font-weight: bold; -fx-color: white; -fx-font-size: 20;">
                                    <items>
                                        <MenuItem text="Nghệ thuật" />
                                        <MenuItem text="Điện tử" />
                                        <MenuItem text="Bất động sản" />
                                        <MenuItem text="Thời trang" />
                                        <MenuItem text="Tài sản khác" />
                                    </items>
                                </ContextMenu>
                            </contextMenu>
                        </Label>

                        <Label onMouseEntered="#handleShowSessionMenu" style="-fx-text-fill: white; -fx-font-size: 20; -fx-font-weight: bold; -fx-cursor: hand;" text="Phiên đấu giá">
                            <contextMenu>
                                <ContextMenu fx:id="sessionMenu" style="-fx-background-color: #1a1a1a; -fx-font-weight: bold; -fx-color: white; -fx-font-size: 20;">
                                    <items>
                                        <MenuItem text="Phiên đấu giá đang diễn ra" />
                                        <MenuItem text="Phiên đấu giá đã kết thúc" />
                                    </items>
                                </ContextMenu>
                            </contextMenu>
                        </Label>
                        <Label style="-fx-text-fill: white; -fx-font-size: 20; -fx-font-weight: bold; -fx-cursor: hand;" text="Tạo phiên đấu giá mới"/>
                    </children>
                    <padding>
                        <Insets left="100.0" />
                    </padding>
                </HBox>

                <HBox alignment="CENTER_RIGHT">
                    <children>
                        <Button mnemonicParsing="false" onAction="#goToHome" prefHeight="50.0" prefWidth="150.0" style="-fx-background-color: #CC0000; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 18; -fx-background-radius: 5; -fx-cursor: hand; -fx-padding: 17 0 17 0" text="Quay lại" />
                    </children>
                </HBox>
            </children>
        </HBox>

        <ScrollPane fitToWidth="true" style="-fx-background-color: #000000; -fx-background: #000000; -fx-border-color: transparent;">
            <content>
                <VBox alignment="TOP_CENTER" spacing="25.0" style="-fx-background-color: #000000;">
                    <children>

                        <HBox alignment="CENTER" spacing="10.0">
                            <children>
                                <Region HBox.hgrow="ALWAYS" />

                                <Label text="ĐĂNG SẢN PHẨM MỚI" textFill="WHITE">
                                    <font>
                                        <Font name="System Bold" size="32.0" /> </font>
                                </Label>

                                <Region HBox.hgrow="ALWAYS" />

                            </children>
                        </HBox>

                        <VBox maxWidth="700.0" spacing="20.0">
                            <children>

                                <VBox spacing="10.0">
                                    <children>
                                        <Label text="Tên sản phẩm:" textFill="WHITE">
                                            <font>
                                                <Font name="System Bold" size="18.0" /> </font>
                                        </Label>
                                        <TextField fx:id="txtName" promptText="Ví dụ: Điện thoại Samsung cũ..." style="-fx-background-color: #2d2d2d; -fx-text-fill: white; -fx-border-color: #444444; -fx-border-radius: 4; -fx-prompt-text-fill: #888888; -fx-font-size: 16px;">
                                            <padding>
                                                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" /> </padding>
                                        </TextField>
                                    </children>
                                </VBox>

                                <VBox spacing="10.0">
                                    <children>
                                        <Label text="Loại sản phẩm:" textFill="WHITE">
                                            <font>
                                                <Font name="System Bold" size="18.0" />
                                            </font>
                                        </Label>
                                        <ComboBox fx:id="cbCategory" prefHeight="45.0" prefWidth="250.0" style="-fx-background-color: #737272;-fx-text-fill: white; -fx-prompt-text-fill: #aaaaaa; -fx-border-color: #444444; -fx-border-radius: 4; -fx-font-size: 16px; " />
                                    </children>
                                </VBox>

                                <VBox spacing="10.0">
                                    <children>
                                        <Label text="Giá khởi điểm (VND):" textFill="WHITE">
                                            <font>
                                                <Font name="System Bold" size="18.0" />
                                            </font>
                                        </Label>
                                        <TextField fx:id="txtPrice" promptText="Ví dụ: 100" style="-fx-background-color: #2d2d2d; -fx-text-fill: white; -fx-border-color: #444444; -fx-border-radius: 4; -fx-prompt-text-fill: #888888; -fx-font-size: 16px;">
                                            <padding>
                                                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                                            </padding>
                                        </TextField>
                                    </children>
                                </VBox>

                                <VBox spacing="10.0">
                                    <children>
                                        <Label text="Ảnh sản phẩm:" textFill="WHITE">
                                            <font>
                                                <Font name="System Bold" size="18.0" />
                                            </font>
                                        </Label>
                                        <HBox alignment="CENTER_LEFT" spacing="15.0">
                                            <children>
                                                <Button mnemonicParsing="false" onAction="#handleChooseImage" style="-fx-background-color: #444444; -fx-cursor: hand;" text="Chọn ảnh..." textFill="WHITE">
                                                    <padding>
                                                        <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
                                                    </padding>
                                                    <font>
                                                        <Font name="System Bold" size="14.0" />
                                                    </font>
                                                </Button>
                                                <Label fx:id="lblImagePath" text="[Chưa có ảnh]" textFill="#aaaaaa">
                                                    <font>
                                                        <Font size="14.0" />
                                                    </font>
                                                </Label>
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>

                                <VBox spacing="10.0">
                                    <children>
                                        <Label text="Mô tả sản phẩm:" textFill="WHITE">
                                            <font>
                                                <Font name="System Bold" size="18.0" />
                                            </font>
                                        </Label>
                                        <TextArea fx:id="txtDesc" prefHeight="150.0" promptText="Mô tả tình trạng, xuất xứ, bảo hành..." style="-fx-control-inner-background: #2d2d2d; -fx-text-fill: white; -fx-border-color: #444444; -fx-border-radius: 4; -fx-prompt-text-fill: #888888; -fx-font-size: 16px;" wrapText="true" />
                                    </children>
                                </VBox>

                                <VBox spacing="10.0">
                                    <children>
                                        <Label text="Thời gian đấu giá:" textFill="WHITE">
                                            <font>
                                                <Font name="System Bold" size="18.0" />
                                            </font>
                                        </Label>
                                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                                            <children>
                                                <TextField fx:id="txtDuration" prefWidth="120.0" promptText="Nhập số" style="-fx-background-color: #2d2d2d; -fx-text-fill: white; -fx-border-color: #444444; -fx-border-radius: 4; -fx-prompt-text-fill: #888888; -fx-font-size: 16px;">
                                                    <padding>
                                                        <Insets bottom="12.0" left="15.0" right="15.0" top="12.0" />
                                                    </padding>
                                                </TextField>
                                                <ComboBox fx:id="cbDurationUnit" prefHeight="45.0" prefWidth="100.0" promptText="Giờ" style="-fx-background-color: #737272; -fx-border-color: #444444; -fx-border-radius: 4; -fx-font-size: 16px;" />
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>

                        <Label fx:id="lblMessage" textFill="#ff5252">
                            <font>
                                <Font name="System Bold" size="16.0" />
                            </font>
                        </Label>

                        <HBox alignment="CENTER">
                            <padding>
                                <Insets bottom="0.0" left="0.0" right="0.0" top="15.0" />
                            </padding>
                            <children>
                                <Button mnemonicParsing="false" onAction="#saveProduct" style="-fx-background-color: #1976D2; -fx-cursor: hand; -fx-background-radius: 5;" text="ĐĂNG SẢN PHẨM ĐẤU GIÁ" textFill="WHITE">
                                    <font>
                                        <Font name="System Bold" size="20.0" /> </font>
                                    <padding>
                                        <Insets bottom="15.0" left="40.0" right="40.0" top="15.0" />
                                    </padding>
                                </Button>
                            </children>
                        </HBox>

                    </children>
                    <padding>
                        <Insets bottom="60.0" left="50.0" right="50.0" top="40.0" />
                    </padding>
                </VBox>
            </content>
        </ScrollPane>
    </children>
</VBox>