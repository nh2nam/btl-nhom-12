<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<VBox prefHeight="800.0" prefWidth="1280.0"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.auction.client.controller.SellingProductController">
    <children>

        <!-- ===== NAVBAR ===== -->
        <HBox alignment="CENTER_LEFT" prefHeight="110.0"
              style="-fx-background-color: black; -fx-border-color: #333333; -fx-border-width: 0 0 1 0; -fx-padding: 20 30 20 30">
            <padding><Insets left="40.0" right="40.0" /></padding>
            <children>

                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label fx:id="lblUsername" onMouseEntered="#handleShowUserMenu"
                               style="-fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;">
                            <font><Font size="20.0" /></font>
                            <contextMenu>
                                <ContextMenu fx:id="userMenu"
                                             style="-fx-background-color: #1a1a1a; -fx-font-weight: bold; -fx-color: white; -fx-font-size: 20;">
                                </ContextMenu>
                            </contextMenu>
                        </Label>
                    </children>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="50.0" HBox.hgrow="ALWAYS">
                    <padding><Insets left="100.0" /></padding>
                    <children>
                        <Label onMouseEntered="#handleShowAuctionMenu"
                               style="-fx-text-fill: white; -fx-font-size: 20; -fx-font-weight: bold; -fx-cursor: hand;"
                               text="Tài sản đấu giá">
                            <contextMenu>
                                <ContextMenu fx:id="auctionMenu"
                                             style="-fx-background-color: #1a1a1a; -fx-font-weight: bold; -fx-color: white; -fx-font-size: 20;">
                                </ContextMenu>
                            </contextMenu>
                        </Label>
                        <Label onMouseEntered="#handleShowSessionMenu"
                               style="-fx-text-fill: white; -fx-font-size: 20; -fx-font-weight: bold; -fx-cursor: hand;"
                               text="Phiên đấu giá">
                            <contextMenu>
                                <ContextMenu fx:id="sessionMenu"
                                             style="-fx-background-color: #1a1a1a; -fx-font-weight: bold; -fx-color: white; -fx-font-size: 20;">
                                </ContextMenu>
                            </contextMenu>
                        </Label>
                        <Label onMouseClicked="#addNewProduct"
                               style="-fx-text-fill: white; -fx-font-size: 20; -fx-font-weight: bold; -fx-cursor: hand;"
                               text="Tạo phiên đấu giá mới"/>
                    </children>
                </HBox>

                <HBox alignment="CENTER_RIGHT">
                    <children>
                        <Button mnemonicParsing="false" onMouseClicked="#goHome"
                                prefHeight="50.0" prefWidth="150.0"
                                style="-fx-background-color: #CC0000; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 18; -fx-background-radius: 5; -fx-cursor: hand; -fx-padding: 17 0 17 0"
                                text="Quay lại" />
                    </children>
                </HBox>

            </children>
        </HBox>

        <!-- ===== NỘI DUNG CHÍNH ===== -->
        <ScrollPane fitToWidth="true"
                    style="-fx-background-color: #1a1a1a; -fx-background: #1a1a1a;"
                    VBox.vgrow="ALWAYS">
            <content>
                <HBox spacing="40.0" style="-fx-padding: 40;">

                    <!-- CỘT TRÁI: Ảnh + Chi tiết + Lịch sử đặt giá -->
                    <VBox spacing="20.0" HBox.hgrow="ALWAYS">

                        <!-- Ảnh sản phẩm -->
                        <VBox alignment="CENTER"
                              style="-fx-background-color: #2a2a2a; -fx-background-radius: 10; -fx-padding: 20;">
                            <!-- Khung ảnh cố định 700x460, dùng StackPane để clip -->
                            <StackPane prefWidth="700.0" prefHeight="460.0" minHeight="460.0" maxHeight="460.0"
                                       style="-fx-background-color: #1a1a1a; -fx-background-radius: 8;">
                                <ImageView fx:id="imgProduct"
                                           fitWidth="700.0" fitHeight="460.0"
                                           preserveRatio="true"
                                           smooth="true" />
                            </StackPane>
                            <!-- Thumbnails điều hướng ảnh -->
                            <HBox fx:id="hboxThumbnails" alignment="CENTER" spacing="10.0"
                                  style="-fx-padding: 15 0 0 0;" />
                        </VBox>

                        <!-- Chi tiết tài sản -->
                        <VBox spacing="10.0"
                              style="-fx-background-color: #2a2a2a; -fx-background-radius: 10; -fx-padding: 25;">
                            <Label text="Chi tiết tài sản đấu giá"
                                   style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;" />
                            <Separator style="-fx-background-color: #444;" />
                            <Label fx:id="lblProductInfo" wrapText="true"
                                   style="-fx-text-fill: #cccccc; -fx-font-size: 16px; -fx-line-spacing: 5px;" />
                        </VBox>

                        <!-- LIVE CHAT ROOM -->
                        <VBox spacing="0"
                              style="-fx-background-color: #2a2a2a; -fx-background-radius: 10; -fx-border-color: #444; -fx-border-radius: 10; -fx-border-width: 1;">

                            <!-- Header -->
                            <HBox alignment="CENTER_LEFT" spacing="8"
                                  style="-fx-padding: 14 20; -fx-background-color: #1e1e1e; -fx-background-radius: 10 10 0 0; -fx-border-color: #444; -fx-border-width: 0 0 1 0;">
                                <Label text="💬" style="-fx-font-size: 18px;" />
                                <Label text="Phòng Chat Trực Tuyến"
                                       style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;" />
                            </HBox>

                            <!-- Vùng hiển thị tin nhắn -->
                            <ScrollPane fx:id="scrollPaneChat"
                                        fitToWidth="true" prefHeight="260.0" minHeight="180.0"
                                        style="-fx-background-color: transparent; -fx-background: #2a2a2a; -fx-border-color: transparent;">
                                <content>
                                    <VBox fx:id="vboxChatMessages" spacing="4"
                                          style="-fx-padding: 10 0 10 0; -fx-background-color: #2a2a2a;" />
                                </content>
                            </ScrollPane>

                            <!-- Ô nhập + nút gửi -->
                            <HBox spacing="8"
                                  style="-fx-padding: 10 14; -fx-background-color: #1e1e1e; -fx-background-radius: 0 0 10 10; -fx-border-color: #444; -fx-border-width: 1 0 0 0;"
                                  alignment="CENTER">
                                <TextField fx:id="txtChatInput"
                                           promptText="Nhập tin nhắn..."
                                           onAction="#handleSendChat"
                                           prefHeight="38.0" HBox.hgrow="ALWAYS"
                                           style="-fx-background-color: #333; -fx-text-fill: white; -fx-prompt-text-fill: #888; -fx-border-color: #555; -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 13px; -fx-padding: 6 10;" />
                                <Button text="Gửi"
                                        onAction="#handleSendChat"
                                        prefHeight="38.0" prefWidth="70"
                                        style="-fx-background-color: #1976D2; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px; -fx-background-radius: 6; -fx-cursor: hand;" />
                            </HBox>

                        </VBox>

                    </VBox>

                    <!-- CỘT PHẢI: Thông tin đấu giá + Đặt giá -->
                    <VBox spacing="20.0" prefWidth="450.0" minWidth="450.0"
                          style="-fx-background-color: #2a2a2a; -fx-background-radius: 10; -fx-border-color: #444; -fx-border-radius: 10; -fx-border-width: 1; -fx-padding: 30;">

                        <Label fx:id="lblProductName" wrapText="true"
                               style="-fx-text-fill: white; -fx-font-size: 26px; -fx-font-weight: bold;" />

                        <Separator style="-fx-background-color: #444;" />

                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <Label text="Giá khởi điểm:" prefWidth="150"
                                   style="-fx-text-fill: #aaaaaa; -fx-font-size: 16px;" />
                            <Label fx:id="lblStartingPrice"
                                   style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;" />
                        </HBox>

                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <Label text="Giá hiện tại:" prefWidth="150"
                                   style="-fx-text-fill: #aaaaaa; -fx-font-size: 16px;" />
                            <Label fx:id="lblCurrentPrice"
                                   style="-fx-text-fill: #ff5252; -fx-font-size: 24px; -fx-font-weight: bold;" />
                        </HBox>

                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <Label text="Thời gian kết thúc:" prefWidth="150"
                                   style="-fx-text-fill: #aaaaaa; -fx-font-size: 16px;" />
                            <Label fx:id="lblEndTime"
                                   style="-fx-text-fill: #4CAF50; -fx-font-size: 16px; -fx-font-weight: bold;" />
                        </HBox>

                        <Separator style="-fx-background-color: #444;" />

                        <VBox spacing="10.0" style="-fx-padding: 10 0 0 0;">
                            <Label text="Nhập mức giá bạn muốn trả:"
                                   style="-fx-text-fill: white; -fx-font-size: 14px;" />
                            <TextField fx:id="txtBidAmount" promptText="Nhap gia"
                                       style="-fx-font-size: 16px; -fx-background-color: #1a1a1a; -fx-text-fill: white; -fx-border-color: #555; -fx-border-radius: 5;"
                                       prefHeight="45.0"/>
                        </VBox>

                        <VBox spacing="15.0" style="-fx-padding: 15 0 0 0;">
                            <Text fx:id="priceCheck"
                                  style="-fx-font-size: 15px; -fx-font-weight: bold;" />
                            <Button fx:id="btnConfirm" text="ĐẶT GIÁ"
                                    onAction="#handleConfirmBid" maxWidth="Infinity" prefHeight="55.0"
                                    style="-fx-background-color: #d32f2f; -fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" />
                            <Button text="ĐẤU GIÁ TỰ ĐỘNG"
                                    onAction="#handleAutoBid" maxWidth="Infinity" prefHeight="55.0"
                                    style="-fx-background-color: #1976D2; -fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" />
                            <Button text="LỊCH SỬ ĐẤU GIÁ"
                                    onAction="#handleShowBidHistory" maxWidth="Infinity" prefHeight="55.0"
                                    style="-fx-background-color: #37474F; -fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" />
                            <Button text="BIỂU ĐỒ GIÁ"
                                    onAction="#handleShowPriceChart" maxWidth="Infinity" prefHeight="55.0"
                                    style="-fx-background-color: #2E7D32; -fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" />
                        </VBox>

                        <VBox VBox.vgrow="ALWAYS" />
                    </VBox>

                </HBox>
            </content>
        </ScrollPane>

    </children>
</VBox>
